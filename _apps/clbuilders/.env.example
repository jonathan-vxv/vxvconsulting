# Copy to .env for `npm run dev` (wrangler reads it). Never commit .env.
# In production set these in Cloudflare (Pages project -> Settings -> Variables and Secrets), as secrets.

# The whole service-account key JSON on ONE line, inside single quotes (the "private_key" keeps its \n escapes).
# Make the one line with:  node -e "console.log(JSON.stringify(require('./key.json')))"
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"REPLACE@REPLACE.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"}'
SHEET_ID=10CaKKiAvTHZ7NN9mC3DY1eZlINsZ7POAdtQhDPk3nHY

# Password for the page. Or set SITE_PASSWORD_SHA256 (hex SHA-256 of the password) instead.
SITE_PASSWORD=REPLACE_ME
# Signs session cookies; 32+ random characters. Changing it signs everyone out.
SESSION_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
# How long a sign-in lasts, in days.
SESSION_DAYS=4

# 1 = use built-in sample rows instead of Google (no credentials needed).
DEMO_DATA=0
